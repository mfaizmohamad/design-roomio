{
  "name": "roomio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts && node scripts/demo-leak-check.mjs && node scripts/size-check.mjs dist-demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "deploy:demo": "npm run build:demo && npx wrangler@4 pages deploy dist-demo --project-name roomio-demo",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src shared scripts server",
    "lint:fix": "eslint src shared scripts server --fix",
    "format": "prettier --write src shared scripts server \"*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check src shared scripts server \"*.{ts,js,mjs,json}\"",
    "check:browser": "node scripts/browser-check.mjs",
    "check:lock": "node scripts/lock-check.mjs",
    "check:auth": "node scripts/auth-check.mjs",
    "check:size": "node scripts/size-check.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high --package-lock-only && npm audit --omit=dev --audit-level=high --package-lock-only --prefix server",
    "check:secrets": "gitleaks dir . --no-banner --redact --verbose",
    "test": "vitest run",
    "test:server": "npm --prefix server test",
    "test:watch": "vitest",
    "test:py": "node scripts/test-python.mjs",
    "test:all": "npm test && npm run test:py",
    "check:detect": "node scripts/detect-check.mjs",
    "scrape:listings": "node scripts/scrape-listings.mjs",
    "replicas": "node scripts/shoot-listing-replica.mjs",
    "replicas:defaults": "node scripts/shoot-listing-replica.mjs defaults",
    "docs:shots": "node scripts/regen-screenshots.mjs",
    "verify:route": "node scripts/verify.mjs route",
    "verify:smoke": "node scripts/verify.mjs smoke",
    "bootstrap:worktree": "node scripts/setup-worktree.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "2.19.1",
    "@sentry/browser": "^11.2.0",
    "canvas-record": "^4.2.0",
    "postprocessing": "6.37.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "three-gpu-pathtracer": "0.0.23",
    "three-stdlib": "^2.36.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
