# Roomio backend configuration. Copy to server/.env and fill in per environment.
# Every value below has a working local-dev default — the ones marked REQUIRED IN
# PRODUCTION are the ones whose defaults are only safe on localhost.

# --- Database ----------------------------------------------------------------
# REQUIRED IN PRODUCTION. Defaults to a local trust-auth database.
DATABASE_URL=postgresql://localhost/roomio

# REQUIRED IN PRODUCTION. `pg` does not infer TLS from the URL, so without this
# the password and every row cross the network in plaintext.
#   require    → TLS, verifying the server certificate (use this)
#   no-verify  → TLS, accepting a self-signed/provider CA (encrypted, unauthenticated)
#   disable    → no TLS (local only)
PGSSLMODE=disable

# Cap connections so a spike queues in node instead of exhausting the database's
# own connection limit (managed Postgres tiers cap this low).
PG_POOL_MAX=10

# --- Schema migrations -------------------------------------------------------
# The schema is server/migrations/*.sql, applied by `npm run migrate` (in
# server/) as an explicit DEPLOY STEP, before the new app process starts. The app
# itself issues no DDL and refuses to boot if a migration is pending.
#
# Optional: a SEPARATE, higher-privilege connection used ONLY by that step.
# Falls back to DATABASE_URL when unset (which is what local dev wants).
# Configuring it is what lets the role in DATABASE_URL hold DML only — with DDL
# rights, one SQL injection anywhere in the API becomes a DROP TABLE.
# MIGRATION_DATABASE_URL=postgresql://roomio_migrator:...@host/roomio

# --- HTTP --------------------------------------------------------------------
PORT=5181

# REQUIRED IN PRODUCTION. Turns on Secure cookies and HSTS.
NODE_ENV=development

# REQUIRED IN PRODUCTION, when a reverse proxy / load balancer sits in front.
# Number of proxy hops to trust for the client IP. MUST stay 0 with no proxy in
# front: trusting X-Forwarded-For unconditionally lets any client forge its own
# IP and walk straight through the rate limiters. On a single PaaS load balancer
# (Render / Fly / Railway / Heroku) the value is 1.
TRUST_PROXY=0

# Only needed when the SPA is served from a DIFFERENT origin than this API.
# Same-origin requests are allowed automatically. Comma-separated.
# ALLOWED_ORIGINS=https://roomio.app,https://www.roomio.app

# Force the session cookie's Secure flag either way (otherwise follows NODE_ENV).
# COOKIE_SECURE=true

# --- Security tuning ---------------------------------------------------------
# bcrypt work factor. Higher = slower for an attacker who stole the hashes, and
# slower for every login. Do not lower this outside tests.
BCRYPT_ROUNDS=12

# Credential brute-force budget (failed attempts only), per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Blanket per-IP ceiling across all of /api.
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=600

# Per-user storage ceiling: each design is an up-to-2MB JSONB blob, so without a
# cap one account can insert designs until the database fills.
MAX_DESIGNS_PER_USER=200

# --- Detection uploads (unauthenticated endpoint) ----------------------------
DETECT_RATE_LIMIT_WINDOW_MS=60000
DETECT_RATE_LIMIT_MAX=12
# Decoded-image byte cap (413 above this).
DETECT_MAX_BYTES=10485760
# Queue ceiling: requests still awaiting a result (429 once full).
DETECT_MAX_PENDING=32

# --- Lifecycle ---------------------------------------------------------------
SESSION_PURGE_INTERVAL_MS=3600000
# How long to let in-flight requests finish on SIGTERM before forcing exit.
SHUTDOWN_TIMEOUT_MS=10000
